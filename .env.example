# Local development only. Replace all values. Use URL-safe secrets for Compose URLs.
MOS_ADMIN_KEY=replace-with-a-long-random-admin-secret
POSTGRES_PASSWORD=replace-with-a-different-strong-secret
MOS_APP_PASSWORD=replace-with-app-specific-secret
MOS_MIGRATION_PASSWORD=replace-with-migration-specific-secret
DATABASE_URL=sqlite:///./marketing_os.db
MOS_MODEL_CALLS_ENABLED=false
# No live key in ordinary tests or CI.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# P1.2 adapters reject real HTTP transports even if a live key is present.
MOS_LIVE_TESTS=false
MOS_ENV=development
# Production requires HTTPS ingress with explicit trusted proxy CIDRs.
# MOS_PUBLIC_URL=https://your-domain
# MOS_TRUSTED_PROXIES=172.20.0.2/32
# One tenant-bound recovery worker per recovery service; never use the admin key.
# MOS_WORKER_TOKEN=
# MOS_RECOVERY_API_URL=http://api:8000

# Threads is separate from AI; all official HTTP and publication are off by default.
MOS_THREADS_HTTP_ENABLED=false
MOS_THREADS_PUBLISH_ENABLED=false
# MOS_THREADS_APP_ID=
# MOS_THREADS_APP_SECRET=
# MOS_THREADS_REDIRECT_URI=https://your-controlled-host/threads/oauth/callback
# MOS_THREADS_TOKEN_KEY=  # Fernet key from an external secret source, never commit it

# Opt-in token maintenance only; never schedules publication.
MOS_THREADS_MAINTENANCE_ENABLED=false
# Development only. Separate release approval is required before any public activation.
MOS_PHONE_SETUP_ENABLED=false
# MOS_PHONE_SETUP_AUTHORITY=  # Only the DPAPI authority's SPKI public key; never a private key.

# Owner policy automation, disabled until separately approved deployment.
MOS_AUTOMATION_ENABLED=false
# MOS_AUTOMATION_TENANT_ID=
