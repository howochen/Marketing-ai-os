# Local development only. Replace all values. Use URL-safe secrets for Compose URLs.
MOS_ADMIN_KEY=replace-with-a-long-random-admin-secret
POSTGRES_PASSWORD=replace-with-a-different-strong-secret
MOS_APP_PASSWORD=replace-with-app-specific-secret
MOS_MIGRATION_PASSWORD=replace-with-migration-specific-secret
DATABASE_URL=sqlite:///./marketing_os.db
MOS_MODEL_CALLS_ENABLED=false
